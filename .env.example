# Resume-Handler: environment variables. All optional; the defaults give a local, loopback-only server with no login.
# Nothing loads this file automatically: export the variables in your shell (or use `node --env-file=.env ...`).
# Never commit a real .env. Every value below is a placeholder.

# --- Server (packages/server) -------------------------------------------------------------
# Login mode: none (loopback only, default) | token (static bearer) | signed (Ed25519 session token)
INTAKE_AUTH=none
# token mode: static bearer token, at least 16 characters
INTAKE_TOKEN=replace-with-a-long-random-string
# signed mode: the issuer's PUBLIC key, either inline PEM (\n for line breaks) or a file path
INTAKE_PUBLIC_KEY=
INTAKE_PUBLIC_KEY_FILE=./public_key.pem
# signed mode: claims the token must carry
INTAKE_TOKEN_AUDIENCE=resume-intake
INTAKE_TOKEN_ROLE=admin
# Bind address and port (default 127.0.0.1 and the first free port in 47831-47840)
INTAKE_HOST=127.0.0.1
INTAKE_PORT=47831
# Extra browser origins and Host names to accept (comma separated), for hosted deployments
INTAKE_ALLOWED_ORIGINS=https://intake.example.com
INTAKE_ALLOWED_HOSTS=intake.example.com
# Built web UI folder (default packages/web/dist); `off` serves the API only
INTAKE_WEB_DIR=
# 1/0: let the page open folders / stop the server (default on for auth=none, off otherwise)
INTAKE_OPEN_FOLDER=
INTAKE_ENABLE_SHUTDOWN=
# Where uploads, results and logs live, where settings live, and the key that encrypts stored secrets
# (64 hex characters or base64 of 32 random bytes; a 0600 key file is created when unset)
INTAKE_DATA_DIR=./.intake-data
INTAKE_CONFIG_DIR=./.intake-data/config
INTAKE_SECRETS_KEY=

# --- Pipeline (packages/core) -------------------------------------------------------------
# 1/0: extract applicant-tracking-system style fields from each résumé
INTAKE_EXTRACT_ATS=

# --- CLI (packages/cli) -------------------------------------------------------------------
# Model key for `intake run` (not needed with --fake). OPENROUTER_API_KEY is accepted as a fallback.
INTAKE_OPENROUTER_API_KEY=sk-or-replace-me
# Bearer token for the ingestion sink (or use --mint-token against the mock CRM)
INTAKE_SINK_TOKEN=replace-with-sink-token
# Browser to use for `intake app` (a Chromium-based browser executable)
INTAKE_BROWSER=
# Dev proxy target for `npm run dev` in packages/web
INTAKE_SERVER=http://127.0.0.1:47831

# --- Mock CRM (packages/mock-crm) ---------------------------------------------------------
MOCK_CRM_PORT=47900
MOCK_CRM_DATA_DIR=./demo-data
# Accept one static token on the ingestion routes, or turn auth off (1) for quick experiments
MOCK_CRM_INGESTION_TOKEN=
MOCK_CRM_OPEN=0
